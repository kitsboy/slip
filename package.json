{
  "name": "slip",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "slip — a non-custodial, serverless, watch-only point-of-sale terminal. Sells pay straight into the merchant's own wallet.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:e2e": "node tests/e2e/keycheck.mjs",
    "fixtures": "node scripts/make-core-fixtures.mjs",
    "deploy": "bash scripts/deploy.sh",
    "version:show": "node -e \"console.log(require('./package.json').version)\""
  },
  "dependencies": {
    "@noble/curves": "1.7.0",
    "@noble/hashes": "1.6.1",
    "@scure/base": "1.2.1",
    "@scure/bip32": "1.6.0",
    "@scure/btc-signer": "1.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@scure/bip39": "1.5.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "jsqr": "1.4.0",
    "playwright": "1.56.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
