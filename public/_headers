# slip — response headers (Cloudflare Pages serves this file verbatim).
# The policy that must be a real header (meta elements ignore it) lives here;
# the script-source policy is baked per-build by vite.config.ts cspPlugin().

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The artifact a merchant verifies must never be cached stale.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
